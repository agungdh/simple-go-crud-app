{
  "name": "simple-go-crud-app",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "root",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Go app",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"],
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.autoUpdate": true,
        "go.testFlags": ["-count=1"]
      }
    }
  }
}
